<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>GitHub in Runesmith: signing in to GitHub, and its repositories, links and pull requests for the Git plugin.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Runesmith.GitHub.Contracts\Runesmith.GitHub.Contracts.csproj" />
  </ItemGroup>
  <!-- Runesmith supplies these when it loads the plugin, so none of them is copied next to it. -->
  <ItemGroup>
    <PackageReference Include="Runesmith.Sdk" ExcludeAssets="runtime" />
    <PackageReference Include="HammerUI" ExcludeAssets="runtime" />
    <PackageReference Include="Avalonia" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Runesmith.GitHub.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- The GitHub App Runesmith signs in as by default; a build can replace this file to ship its own app. -->
    <EmbeddedResource Include="github-app.json" LogicalName="github-app.json" />
  </ItemGroup>
</Project>
